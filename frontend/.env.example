# Frontend Environment Configuration (Vite)
# NOTE: VITE_* variables are bundled into the browser client and must NEVER contain private keys or admin secrets.

# Backend API URL (Use your deployed Render / Railway / Cloud Run API URL in production)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase Client Web App Credentials (Optional for local hybrid mode, required for live Firebase project)
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForDevelopmentOnly
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
