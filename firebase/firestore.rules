rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function ownsNew() { return signedIn() && request.resource.data.ownerId == request.auth.uid; }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /patients/{patientId} {
      allow create: if ownsNew() && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100;
      allow read, delete: if ownsExisting();
      allow update: if ownsExisting() && ownsNew()
        && request.resource.data.ownerId == resource.data.ownerId;
    }
    match /assessments/{assessmentId} {
      allow create: if ownsNew() && request.resource.data.patientId is string
        && request.resource.data.riskLevel in ['High', 'Low']
        && request.resource.data.probability is number
        && request.resource.data.probability >= 0 && request.resource.data.probability <= 1;
      allow read, delete: if ownsExisting();
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

