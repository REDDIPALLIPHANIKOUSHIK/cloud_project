# Flask API Configuration
FLASK_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Model Paths (Defaults to backend/ml/)
MODEL_ARTIFACT_PATH=backend/ml/model_artifacts/heart_disease_model.joblib
MODEL_METADATA_PATH=backend/ml/model_metadata.json

# Firebase Admin SDK Configuration (Optional in local development mode)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=path/to/firebase-service-account-key.json
