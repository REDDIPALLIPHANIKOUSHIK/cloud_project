# =========================================================================
# ROOT ENVIRONMENT VARIABLES TEMPLATE - CLOUD-BASED HEALTHCARE SYSTEM
# =========================================================================

# Backend API Configuration
FLASK_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173,https://your-vercel-deployment.vercel.app

# Machine Learning Artifacts
MODEL_ARTIFACT_PATH=backend/ml/model_artifacts/heart_disease_model.joblib
MODEL_METADATA_PATH=backend/ml/model_metadata.json

# Firebase Admin SDK Configuration (Server-Side Only - NEVER expose to frontend)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=backend/config/firebase-service-account-key.json

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
